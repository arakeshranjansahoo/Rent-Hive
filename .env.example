# =====================================================
# RentHive Environment Configuration
# =====================================================
# Copy this file to `.env` and replace placeholder values.
# NEVER commit the real `.env` file.

# -------------------------
# Flask Core (REQUIRED)
# -------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production
PORT=5000

# -------------------------
# Database
# -------------------------
# Production: Render Postgres / Heroku Postgres / managed PostgreSQL
# Render provides DATABASE_URL automatically. The app auto-normalizes
# postgres:// -> postgresql:// for SQLAlchemy.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Local development fallback (uncomment to use SQLite locally only):
# DATABASE_URL=sqlite:///renthive.db

# -------------------------
# File Uploads
# -------------------------
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
BILLS_FOLDER=bills

# -------------------------
# Email (SMTP) - Optional
# -------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/application.log
ERROR_LOG_FILE=logs/error.log

# -------------------------
# AI / OCR (Optional)
# -------------------------
TESSERACT_PATH=/usr/bin/tesseract